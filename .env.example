# ─────────────────────────────────────────────────────────────
# Sinapsa (codename one-rrss) — example env (root, mirrored by backend/.env)
# Copy to `.env` in the project root AND in `backend/.env` after composer install.
# ─────────────────────────────────────────────────────────────

# App
APP_NAME=Sinapsa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:48000
FRONTEND_URL=http://localhost:3002
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (Postgres 16, sin PostGIS — no necesitamos geo aquí)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sinapsa
DB_USERNAME=sinapsa
DB_PASSWORD=sinapsa

# Redis (cache, sessions, queues, locks, broadcasting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queues — Horizon
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb

# Mail (Mailpit dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@sinapsa.local"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum (cookie + bearer)
SANCTUM_STATEFUL_DOMAINS=localhost:3002,localhost
SESSION_DOMAIN=localhost

# Tenancy
TENANCY_CENTRAL_DOMAIN=sinapsa.local

# Reverb (WebSocket nativo Laravel) — para realtime de la bandeja
REVERB_APP_ID=sinapsa-local
REVERB_APP_KEY=sinapsa-key-local
REVERB_APP_SECRET=sinapsa-secret-local
# En docker compose el backend conecta al container `reverb` por nombre de servicio.
# El proceso reverb:start sigue bindeando a 0.0.0.0 (parámetro CLI en docker-compose.yml).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ─────────────────────────────────────────────────────────────
# META (Facebook / WhatsApp / Instagram / Messenger)
# Crea una App en https://developers.facebook.com → tipo Business.
# Estos valores se rellenan al registrar la app de Sinapsa en Meta.
# ─────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v22.0

# Webhook verification (lo configuras en Meta Developer Console)
META_WEBHOOK_VERIFY_TOKEN=cambiame-en-prod

# Embedded Signup (config_id de la WhatsApp Embedded Signup configuration)
META_WA_EMBEDDED_SIGNUP_CONFIG_ID=

# Para recibir webhooks Meta en local: ngrok http 68000 → pegar el https://*.ngrok.app aquí
META_PUBLIC_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# Object storage (Cloudflare R2 / AWS S3) — para media WA/IG
# En dev se puede dejar vacío y usar el disk 'local'.
# ─────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=sinapsa-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
